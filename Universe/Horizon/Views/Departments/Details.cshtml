<h1 class="alert alert-info text-center">Department Details</h1>

@model Department


<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

</dl>
<ul class="list-group col-4 text-center">
    <li class="list-group-item active fw-bold">Employees</li>
    @foreach (var employee in Model.Employees)
    {
        <a asp-controller="Employees" style="text-decoration:none"
           asp-action="GetDetailsView" asp-route-id="@employee.Id">
            <li class="list-group-item list-group-item-action">
                @employee.FullName (@employee.Position)
            </li>
        </a>
    }
</ul>

<a asp-controller="Departments" asp-action="GetIndexView">Back to list</a>

<div style="height:200px"></div>
