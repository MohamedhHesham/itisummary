<h1 class="alert alert-link text-center">Create Department</h1>


@model Department
<div class="row">
    <form method="post" asp-controller="Departments" asp-action="AddNew" class="col-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div>
            <label asp-for="Name" class="form-label"></label>
            <input type="text" asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Description" class="form-label"></label>
            <input type="text" asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Add</button>
            <a asp-controller="Departments" asp-action="GetIndexView" class="btn btn-secondary">Back to List</a>

        </div>
    </form>
</div>
