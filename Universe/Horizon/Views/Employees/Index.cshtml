<h1 class="alert alert-success text-center">Employees Index</h1>
@model List<Employee>

    <h3 class="alert alert-info">@ViewBag.Country</h3>
    <h3 class="alert alert-warning">@ViewBag.Discount.ToString("P1")</h3>
<form method="get">
    <div class="input-group">
        <input type="text" name="search" class="form-control" value="@ViewBag.CurrentSearch"/>
        <button type="submit" class="btn btn-secondary">Search</button>
    </div>
</form>
<br />
<a class="fw-bold btn btn-success" asp-controller="Employees" asp-action="GetCreateView" >Create New</a>

<table class="table table-bordered table-striped table-hover text-center">
    <caption class="caption-top text-center fs-3">All Employees</caption>
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>
                <div style="width:50%; float: left; text-align: left">Full Name</div>
                <div style="width:50%; float: right; text-align: right">
                    <a asp-controller="Employees" asp-action="GetIndexView"
                    asp-route-sortType="FullName" asp-route-sortOrder="asc" asp-route-search="@ViewBag.CurrentSearch"><i class="bi bi-arrow-up"></i></a>
                    <a asp-controller="Employees" asp-action="GetIndexView"
                    asp-route-sortType="FullName" asp-route-sortOrder="desc" asp-route-search="@ViewBag.CurrentSearch"><i class="bi bi-arrow-down"></i></a>
                </div>


            </th>
            <th>
                <div style="width:50%; float: left; text-align: left">Position</div>
                <div style="width:50%; float: right; text-align: right">
                    <a asp-controller="Employees" asp-action="GetIndexView"
                    asp-route-sortType="Position" asp-route-sortOrder="asc" asp-route-search="@ViewBag.CurrentSearch"><i class="bi bi-arrow-up"></i></a>
                    <a asp-controller="Employees" asp-action="GetIndexView"
                    asp-route-sortType="Position" asp-route-sortOrder="desc" asp-route-search="@ViewBag.CurrentSearch"><i class="bi bi-arrow-down"></i></a>
                </div>
            </th>
            <th>
                <div style="width:50%; float: left; text-align: left">Salary</div>
                <div style="width:50%; float: right; text-align: right">
                    <a asp-controller="Employees" asp-action="GetIndexView"
                    asp-route-sortType="Salary" asp-route-sortOrder="asc" asp-route-search="@ViewBag.CurrentSearch"><i class="bi bi-arrow-up"></i></a>
                    <a asp-controller="Employees" asp-action="GetIndexView"
                    asp-route-sortType="Salary" asp-route-sortOrder="desc" asp-route-search="@ViewBag.CurrentSearch"><i class="bi bi-arrow-down"></i></a>
                </div>
            </th>
            <th>Image
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (Employee employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.FullName</td>
                <td>@employee.Position</td>
                <td>@employee.Salary</td>
                <td>
                    <img src="@employee.ImagePath" style="object-fit:contain" class="col-4" />
                </td>
                <div class="input-group">
                <td>  <a asp-controller="Employees" asp-action="GetDetailsView" asp-route-id=@employee.Id
                
                class="btn btn-outline-secondary"><i class="bi bi-list-ul" title="Details"></i></a>

                        <a asp-controller="Employees" asp-action="GetEditView" asp-route-id=@employee.Id
                        
                        class="btn btn-outline-primary"><i class="bi bi-pencil-square" title="Edit"></i></a>

                        <a asp-controller="Employees" asp-action="GetDeleteView" asp-route-id=@employee.Id
                        
                        class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                    </td>
                </div>

            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" style="text-align:right">Total</th>
            <th>@Model.Sum(e => e.Salary)</th>
        </tr>
    </tfoot>
</table>
    <div style="height:200px"></div>


@foreach (Employee employee in Model)
{
    <div class="card mb-3 text-center"
         style="display:inline-block; width:24%;">
        <div class="card-header">@employee.Id</div>
        <div class="card-body">
            <h5 class="card-title">@employee.FullName</h5>
            <p class="card-text">@employee.Salary</p>
        </div>
        <div class="card-footer">@employee.Position</div>
    </div>
}

@foreach (Employee employee in Model)
{
    <div class="card mb-3 text-center bg-primary text-white"
         style="display:inline-block; width:18%;">
        <div class="card-header">@employee.Id</div>
        <div class="card-body">
            <h5 class="card-title">@employee.FullName</h5>
            <p class="card-text">@employee.Salary</p>
        </div>
        <div class="card-footer">@employee.Position</div>
    </div>
}

@foreach (Employee employee in Model)
{
    <div class="card mb-3 text-center bg-transparent border-success"
         style="display:inline-block; width:18%;">
        <div class="card-header bg-transparent border-success">@employee.Id</div>
        <div class="card-body  bg-transparent border-success">
            <h5 class="card-title">@employee.FullName</h5>
            <p class="card-text">@employee.Salary</p>
        </div>
        <div class="card-footer  bg-transparent border-success ">@employee.Position</div>
    </div>
}


